# Bole.to Production Infrastructure Configuration
# Copy this file to production.tfvars and fill in the actual values

# General Configuration
aws_region     = "us-east-1"
environment    = "production"
project_name   = "boleto"
project_owner  = "bole.to-team"

# Domain Configuration
domain_name       = "api.bole.to"
route53_zone_id   = "Z1234567890ABC"  # Replace with your actual Route 53 hosted zone ID

# Network Configuration
vpc_cidr                 = "10.0.0.0/16"
public_subnet_cidrs      = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs     = ["10.0.10.0/24", "10.0.20.0/24"]
database_subnet_cidrs    = ["10.0.51.0/24", "10.0.52.0/24"]

# Database Configuration
db_engine_version    = "15.4"
db_instance_class    = "db.t3.medium"      # Start with t3.medium, scale up as needed
db_allocated_storage = 100                 # GB - will auto-scale up to 1TB
db_name             = "boleto_production"
db_username         = "boleto_admin"
# db_password is set via environment variable or secure input

# Cache Configuration
redis_node_type  = "cache.t3.micro"       # Start small, scale up as needed
redis_num_nodes  = 2                      # Multi-AZ for high availability

# Application Configuration
cors_origins = [
  "https://app.bole.to",
  "https://www.bole.to",
  "com.bole.to://"
]
rate_limit_max      = "1000"              # Requests per 15-minute window
hievents_api_url    = "http://localhost:8000/api"

# Auto Scaling Configuration
gateway_min_capacity     = 2
gateway_max_capacity     = 10
gateway_desired_capacity = 2
gateway_cpu             = 1024            # 1 vCPU
gateway_memory          = 2048            # 2GB

hievents_min_capacity     = 2
hievents_max_capacity     = 10
hievents_desired_capacity = 2
hievents_cpu             = 2048           # 2 vCPU
hievents_memory          = 4096           # 4GB

# Container Images - Update these with your ECR repository URLs
gateway_image   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/boleto-gateway:latest"
hievents_image  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/boleto-hi-events:latest"

# Monitoring Configuration
alert_email_addresses = [
  "alerts@bole.to",
  "devops@bole.to"
]

# Feature Flags
enable_https_redirect      = true
enable_waf                 = true
enable_backup_retention    = true
enable_performance_insights = true
enable_enhanced_monitoring  = true

# Cost Optimization
enable_spot_instances           = false    # Keep false for production stability
s3_lifecycle_transition_days    = 30       # Move to IA after 30 days
s3_lifecycle_expiration_days    = 365      # Delete after 1 year

# Security Configuration (Set these as environment variables or via AWS Secrets Manager)
# Export these before running terraform:
# export TF_VAR_db_password="your-secure-db-password"
# export TF_VAR_jwt_private_key="$(cat jwt_private_key.pem)"
# export TF_VAR_jwt_public_key="$(cat jwt_public_key.pem)"
# export TF_VAR_google_client_id="your-google-client-id"
# export TF_VAR_google_client_secret="your-google-client-secret"
# export TF_VAR_apple_client_id="your-apple-client-id"
# export TF_VAR_apple_key_id="your-apple-key-id"
# export TF_VAR_apple_team_id="your-apple-team-id"
# export TF_VAR_apple_private_key="$(cat apple_private_key.p8)"
# export TF_VAR_stripe_secret_key="sk_live_your-stripe-secret-key"
# export TF_VAR_stripe_webhook_secret="whsec_your-webhook-secret"

# The following variables are typically set via environment variables for security:
# db_password              = "secure-database-password"
# jwt_private_key          = "RS256 private key for JWT signing"
# jwt_public_key           = "RS256 public key for JWT verification"
# google_client_id         = "Google OAuth client ID"
# google_client_secret     = "Google OAuth client secret"
# apple_client_id          = "Apple OAuth client ID"
# apple_key_id            = "Apple OAuth key ID"
# apple_team_id           = "Apple OAuth team ID"
# apple_private_key       = "Apple OAuth private key"
# stripe_secret_key       = "Stripe live secret key"
# stripe_webhook_secret   = "Stripe webhook secret"

# Example production deployment commands:
# 
# 1. Set up AWS credentials and region:
#    aws configure set region us-east-1
# 
# 2. Initialize Terraform:
#    terraform init
# 
# 3. Create a plan:
#    terraform plan -var-file="production.tfvars" -out=production.plan
# 
# 4. Review the plan carefully, then apply:
#    terraform apply production.plan
# 
# 5. Build and push container images:
#    ./scripts/build-and-push.sh production
# 
# 6. Update ECS services with new images:
#    ./scripts/deploy-services.sh production
# 
# 7. Run post-deployment verification:
#    ./scripts/verify-deployment.sh production