import React, { useState, useEffect } from 'react';
import {
  View,
  StyleSheet,
  SafeAreaView,
  TouchableOpacity,
  Text,
  ActivityIndicator,
  Alert,
} from 'react-native';
import { Feather } from '@expo/vector-icons';
import { StreamlinedEventForm } from './StreamlinedEventForm';
import { colors, spacing, typography } from '../../../theme/v2-neutral';
import { useApi } from '../../../api';

interface StreamlinedEventFormModalProps {
  route?: any;
  navigation?: any;
}

function StreamlinedEventFormModal(props: StreamlinedEventFormModalProps) {
  const { route, navigation } = props;
  const api = useApi();
  const [isLoading, setIsLoading] = useState(true);
  const [localDraftId, setLocalDraftId] = useState<string | undefined>(undefined);
  
  // Always create a new draft when this screen opens
  useEffect(() => {
    const initializeDraft = async () => {
      setIsLoading(true);
      try {
        console.log('StreamlinedEventFormModal: Creating new draft...');
        const result = await api.createEventDraft();
        console.log('StreamlinedEventFormModal: Draft created:', result);
        
        if (result && result.id) {
          setLocalDraftId(result.id);
        } else {
          throw new Error('Failed to create draft - no ID returned');
        }
      } catch (error) {
        console.error('StreamlinedEventFormModal: Error creating draft:', error);
        Alert.alert('Error', 'Failed to create event draft', [
          { text: 'OK', onPress: () => navigation?.goBack() }
        ]);
      } finally {
        setIsLoading(false);
      }
    };
    
    initializeDraft();
  }, []);
  
  const handleClose = () => {
    navigation?.goBack();
  };

  return (
    <SafeAreaView style={styles.container}>
      {/* Header */}
      <View style={styles.header}>
        <View style={styles.headerLeft}>
          <TouchableOpacity
            style={styles.closeButton}
            onPress={handleClose}
          >
            <Feather name="x" size={24} color={colors.text.primary} />
          </TouchableOpacity>
        </View>
        
        <View style={styles.headerCenter}>
          <Text style={styles.headerTitle}>Create Event</Text>
        </View>
        
        <View style={styles.headerRight} />
      </View>

      {/* Form Content */}
      {isLoading ? (
        <View style={styles.loadingContainer}>
          <ActivityIndicator size="large" color={colors.accent} />
          <Text style={styles.loadingText}>Creating event draft...</Text>
        </View>
      ) : localDraftId ? (
        <StreamlinedEventForm
          draftId={localDraftId}
          onClose={handleClose}
        />
      ) : (
        <View style={styles.errorContainer}>
          <Text style={styles.errorText}>Failed to initialize event</Text>
          <TouchableOpacity style={styles.retryButton} onPress={() => navigation?.goBack()}>
            <Text style={styles.retryButtonText}>Go Back</Text>
          </TouchableOpacity>
        </View>
      )}
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: colors.bg,
  },
  header: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
    paddingHorizontal: spacing(4),
    paddingVertical: spacing(3),
    borderBottomWidth: 1,
    borderBottomColor: colors.border,
    backgroundColor: colors.surface1,
  },
  headerLeft: {
    flex: 1,
    alignItems: 'flex-start',
  },
  headerCenter: {
    flex: 2,
    alignItems: 'center',
  },
  headerRight: {
    flex: 1,
  },
  closeButton: {
    padding: spacing(1),
  },
  headerTitle: {
    fontSize: typography.sizes.lg,
    fontWeight: typography.weights.semibold,
    color: colors.text.primary,
  },
  loadingContainer: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
  },
  loadingText: {
    marginTop: spacing(3),
    fontSize: typography.sizes.md,
    color: colors.text.secondary,
  },
  errorContainer: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    padding: spacing(6),
  },
  errorText: {
    fontSize: typography.sizes.lg,
    color: colors.text.primary,
    marginBottom: spacing(4),
    textAlign: 'center',
  },
  retryButton: {
    backgroundColor: colors.accent,
    paddingHorizontal: spacing(6),
    paddingVertical: spacing(3),
    borderRadius: 8,
  },
  retryButtonText: {
    color: colors.bg,
    fontSize: typography.sizes.md,
    fontWeight: typography.weights.semibold,
  },
});

// Default export for navigation
export default StreamlinedEventFormModal;

// Named export for other uses
export { StreamlinedEventFormModal };