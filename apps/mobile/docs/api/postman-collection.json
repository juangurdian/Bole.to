      "name": "JWKS & Service Integration",
      "item": [
        {
          "name": "Get JWKS (Public Keys)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWKS retrieved successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('JWKS contains keys array', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.keys).to.be.an('array');",
                  "    pm.expect(data.keys.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Keys have correct format', function () {",
                  "    const keys = pm.response.json().keys;",
                  "    keys.forEach(key => {",
                  "        pm.expect(key.kty).to.equal('RSA');",
                  "        pm.expect(key.use).to.equal('sig');",
                  "        pm.expect(key.alg).to.equal('RS256');",
                  "        pm.expect(key.kid).to.be.a('string');",
                  "        pm.expect(key.n).to.be.a('string');",
                  "        pm.expect(key.e).to.be.a('string');",
                  "    });",
                  "});",
