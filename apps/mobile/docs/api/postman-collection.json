        {
          "name": "JWT Signature Verification Test",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// This script demonstrates how to verify JWT in services",
                  "const accessToken = pm.collectionVariables.get('access_token');",
                  "",
                  "if (accessToken) {",
                  "    try {",
                  "        const tokenParts = accessToken.split('.');",
                  "        const header = JSON.parse(atob(tokenParts[0]));",
                  "        const payload = JSON.parse(atob(tokenParts[1]));",
                  "        ",
                  "        console.log('JWT Header:', JSON.stringify(header, null, 2));",
                  "        console.log('JWT Payload:', JSON.stringify(payload, null, 2));",
                  "        console.log('Key ID (kid):', header.kid);",
                  "        console.log('Algorithm:', header.alg);",
                  "        console.log('Issuer:', payload.iss);",
                  "        console.log('Subject:', payload.sub);",
                  "        console.log('Audience:', payload.aud);",
                  "        console.log('Expires:', new Date(payload.exp * 1000).toISOString());",
                  "        ",
                  "        pm.collectionVariables.set('jwt_kid', header.kid);",
                  "    } catch (e) {",
                  "        console.log('Could not decode JWT:', e.message);",
                  "    }",
                  "} else {",
                  "    console.log('No access token available. Please login first.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Service can identify required key for verification', function () {",
                  "    const kid = pm.collectionVariables.get('jwt_kid');",
                  "    pm.expect(kid).to.be.a('string');",
                  "    ",
                  "    // Verify the key exists in JWKS",
                  "    const jwksResponse = pm.response.json();",
                  "    const matchingKey = jwksResponse.keys.find(key => key.kid === kid);",
                  "    pm.expect(matchingKey).to.not.be.undefined;",
                  "});",
                  "",
                  "console.log('JWT Verification Guide:');",
                  "console.log('1. Extract kid from JWT header');",
                  "console.log('2. Find matching key in JWKS response');",
                  "console.log('3. Use RSA public key to verify RS256 signature');",
                  "console.log('4. Validate claims (iss, aud, exp, iat)');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/.well-known/jwks.json",
              "host": ["{{gateway_url}}"],
              "path": [".well-known", "jwks.json"]
            }
          }
        }
      ]
