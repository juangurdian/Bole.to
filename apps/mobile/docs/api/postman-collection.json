{
  "info": {
    "name": "Bole.to Unified Authentication API",
    "description": "Complete authentication API collection for the Bole.to unified authentication system. Uses Gateway service with RS256 JWTs, PKCE OAuth flows, and JWKS verification. Includes all authentication flows, error scenarios, and service integration endpoints.",
    "version": "2.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh JWT token if needed",
          "const tokenExpiry = pm.collectionVariables.get('token_expiry');",
          "const refreshToken = pm.collectionVariables.get('refresh_token');",
          "",
          "if (tokenExpiry && refreshToken) {",
          "    const now = new Date().getTime();",
          "    const expiryTime = new Date(tokenExpiry).getTime();",
          "    ",
          "    // Refresh token 5 minutes before expiry",
          "    if (now >= (expiryTime - 300000)) {",
          "        pm.sendRequest({",
          "            url: pm.collectionVariables.get('gateway_url') + '/auth/refresh',",
          "            method: 'POST',",
          "            header: {",
          "                'Content-Type': 'application/json',",
          "                'Accept': 'application/json'",
          "            },",
          "            body: {",
          "                mode: 'raw',",
          "                raw: JSON.stringify({",
          "                    refreshToken: refreshToken",
          "                })",
          "            }",
          "        }, function (err, response) {",
          "            if (!err && response.code === 200) {",
          "                const data = response.json().data;",
          "                pm.collectionVariables.set('access_token', data.accessToken);",
          "                const newExpiry = new Date(Date.now() + (data.expiresIn * 1000)).toISOString();",
          "                pm.collectionVariables.set('token_expiry', newExpiry);",
          "                console.log('JWT token auto-refreshed successfully');",
          "            } else {",
          "                console.log('Token refresh failed:', err || response.json());",
          "            }",
          "        });",
          "    }",
          "}",
          "",
          "// Add request tracing",
          "pm.collectionVariables.set('request_id', pm.variables.replaceIn('{{$guid}}'));",
          "pm.request.headers.add({",
          "    key: 'X-Request-ID',",
          "    value: pm.collectionVariables.get('request_id')",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test for all requests",
          "pm.test('Response time is acceptable', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "pm.test('Response has required security headers', function () {",
          "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.equal('nosniff');",
          "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.equal('DENY');",
          "    pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string');",
          "});",
          "",
          "// Auto-extract JWT tokens for successful auth requests",
          "if (pm.response.code === 200 && pm.response.json().data && pm.response.json().data.tokens) {",
          "    const tokens = pm.response.json().data.tokens;",
          "    pm.collectionVariables.set('access_token', tokens.accessToken);",
          "    if (tokens.refreshToken) {",
          "        pm.collectionVariables.set('refresh_token', tokens.refreshToken);",
          "    }",
          "    const expiry = new Date(Date.now() + (tokens.expiresIn * 1000)).toISOString();",
          "    pm.collectionVariables.set('token_expiry', expiry);",
          "    ",
          "    // Decode and validate JWT structure (header only for testing)",
          "    try {",
          "        const tokenParts = tokens.accessToken.split('.');",
          "        if (tokenParts.length === 3) {",
          "            const header = JSON.parse(atob(tokenParts[0]));",
          "            pm.test('JWT has correct algorithm and key ID', function () {",
          "                pm.expect(header.alg).to.equal('RS256');",
          "                pm.expect(header.kid).to.be.a('string');",
          "                pm.expect(header.typ).to.equal('JWT');",
          "            });",
          "        }",
          "    } catch (e) {",
          "        console.log('JWT header validation skipped:', e.message);",
          "    }",
          "}",
          "",
          "// Store user information from successful auth responses",
          "if (pm.response.code === 200 && pm.response.json().data && pm.response.json().data.user) {",
          "    const user = pm.response.json().data.user;",
          "    pm.collectionVariables.set('user_id', user.id);",
          "    pm.collectionVariables.set('user_email', user.email);",
          "    pm.collectionVariables.set('user_role', user.role);",
          "}"
        ]
      }
    }
