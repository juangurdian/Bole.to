    {
      "name": "OAuth Authentication",
      "item": [
        {
          "name": "Generate PKCE Challenge",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate PKCE code verifier",
                  "const codeVerifier = Array.from(crypto.getRandomValues(new Uint8Array(32)))",
                  "    .map(byte => String.fromCharCode(byte))",
                  "    .join('')",
                  "    .replace(/[^a-zA-Z0-9\\-._~]/g, '')",
                  "    .substring(0, 128);",
                  "",
                  "pm.collectionVariables.set('oauth_code_verifier', codeVerifier);",
                  "",
                  "// Generate PKCE code challenge (SHA256 of verifier, base64url encoded)",
                  "const encoder = new TextEncoder();",
                  "const data = encoder.encode(codeVerifier);",
                  "crypto.subtle.digest('SHA-256', data).then(hash => {",
                  "    const hashArray = new Uint8Array(hash);",
                  "    const codeChallenge = btoa(String.fromCharCode.apply(null, hashArray))",
                  "        .replace(/\\+/g, '-')",
                  "        .replace(/\\//g, '_')",
                  "        .replace(/=/g, '');",
                  "    ",
                  "    pm.collectionVariables.set('oauth_code_challenge', codeChallenge);",
                  "});",
                  "",
                  "// Generate state parameter",
                  "const state = btoa(JSON.stringify({",
                  "    provider: 'google',",
                  "    timestamp: Date.now(),",
                  "    nonce: Math.random().toString(36).substring(2)",
                  "}));",
                  "",
                  "pm.collectionVariables.set('oauth_state', state);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PKCE parameters generated', function () {",
                  "    pm.expect(pm.collectionVariables.get('oauth_code_verifier')).to.be.a('string');",
                  "    pm.expect(pm.collectionVariables.get('oauth_code_challenge')).to.be.a('string');",
                  "    pm.expect(pm.collectionVariables.get('oauth_state')).to.be.a('string');",
                  "});",
                  "",
                  "console.log('Code Verifier:', pm.collectionVariables.get('oauth_code_verifier'));",
                  "console.log('Code Challenge:', pm.collectionVariables.get('oauth_code_challenge'));",
                  "console.log('State:', pm.collectionVariables.get('oauth_state'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "https://httpbin.org/status/200",
            "description": "This is a placeholder request to generate PKCE parameters in the pre-request script"
          }
        },
