# Environment
NODE_ENV=production

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Hi.Events Backend URL (should be internal/private URL in production)
HIEVENTS_BACKEND_URL=http://hievents-backend:8000

# Database Configuration (for health checks if needed)
DATABASE_URL=postgresql://username:password@localhost:5432/hievents_staging

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGINS=exp://localhost:*,exp://127.0.0.1:*,exp://192.168.*:*,http://localhost:*,https://staging-api.bole.to,https://app.bole.to

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000

# Request Timeout
REQUEST_TIMEOUT=30000